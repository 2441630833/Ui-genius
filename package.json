        },
        "npmurl": ""
    },
    "repository": "",
    "uni_modules": {
        "platforms": {
            "cloud": {
                "tcb": "y",
                "aliyun": "y"
            },
            "client": {
                "App": {
                    "app-vue": "u",
                    "app-nvue": "u"
                },
                "H5-mobile": {
                    "Safari": "u",
                    "Android Browser": "u",
                    "微信浏览器(Android)": "u",
                    "QQ浏览器(Android)": "u"
                },
                "H5-pc": {
                    "Chrome": "u",
                    "IE": "u",
                    "Edge": "u",
                    "Firefox": "u",
                    "Safari": "u"
                },
                "小程序": {
                    "微信": "u",
                    "阿里": "u",
                    "百度": "u",
                    "字节跳动": "u",
                    "QQ": "u",
                    "京东": "u"
                },
                "快应用": {
                    "华为": "u",
                    "联盟": "u"
                },
                "Vue": {
                    "vue2": "u",
                    "vue3": "u"
                }
            }
        }
    },
    "dependencies": {
        "@grapesjs/studio-sdk": "^1.0.45",
        "@grapesjs/studio-sdk-plugins": "^1.0.21",
        "file-saver": "^2.0.5",
        "jszip": "^3.10.1",
        "electron-icon-builder": "^2.0.1"
    },
    "devDependencies": {
        "html2canvas": "^1.4.1",
        "electron": "^38.1.2",
        "electron-builder": "^26.0.12"
    },
    "main": "electron/main.js",
    "scripts": {
        "electron": "electron .",
        "dist:win": "electron-builder -w",
        "dist:dir": "electron-builder --dir",
        "dist:appx": "electron-builder --win --x64 --config.win.target=appx --publish never"
    },
    "build": {
        "appId": "com.uigenius.app",
        "productName": "Uigenius",
        "directories": {
            "buildResources": "./build/icons",
            "output": "dist_electron"
        },
        "files": [
            "electron/**/*",
            "unpackage/dist/build/web/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "static",
                "to": "static"
            }
        ],
        "asar": true,
        "extraMetadata": {
            "main": "electron/main.js"
        },
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "appx",
                    "arch": [
                      "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true
        },
        "appx": {
            "identityName": "AD11B95F.Uigenius",
            "publisher": "CN=69601FC2-D90D-4AFF-889C-6B7EE5281E09",
            "publisherDisplayName": "朱龙泽",
            "applicationId": "com.uigenius.app",
            "languages": [
              "en-US"
            ]
        }
    }
}
