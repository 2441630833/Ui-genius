pipeline {
    agent any
    environment {
        // Define the image name and tag as environment variables
        IMAGE_NAME = 'ui-genius-api' 
        IMAGE_TAG = 'latest'
        CONTAINER_NAME = 'ui-genius-api-container'
        VOLUME_NAME = 'ui-genius-uploads-volume'
        PORT = '8000'
    }
    stages {
        stage('Check Running Container') {
            steps {
                script {
                    // Check if container exists and remove it
                    try {
                        sh "docker container inspect ${CONTAINER_NAME}"
                        echo "Container ${CONTAINER_NAME} exists. Stopping and removing..."
                        sh "docker container stop ${CONTAINER_NAME}"
                        sh "docker container rm ${CONTAINER_NAME}"
                    } catch (Exception e) {
                        echo "No existing container named ${CONTAINER_NAME} found."
                    }
                    
                    // Check if image exists and remove it
                    try {
                        sh "docker image inspect ${IMAGE_NAME}:${IMAGE_TAG}"
                        echo "Image ${IMAGE_NAME}:${IMAGE_TAG} exists. Removing..."
                        sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} -f"
                    } catch (Exception e) {
                        echo "No existing image ${IMAGE_NAME}:${IMAGE_TAG} found."
                    }
                }
            }
        }
        
        stage('Create Docker Volume') {
            steps {
                script {
                    // Check if volume exists, create if not
                    try {
                        sh "docker volume inspect ${VOLUME_NAME}"
                        echo "Volume ${VOLUME_NAME} already exists."
                    } catch (Exception e) {
                        echo "Creating volume ${VOLUME_NAME}..."
                        sh "docker volume create ${VOLUME_NAME}"
                    }
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    dir('back-end') {
                        // Build the Docker image
                        echo "Building Docker image ${IMAGE_NAME}:${IMAGE_TAG}..."
                        sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                    }
                }
            }
        }
        
        stage('Run Docker Container') {
            steps {
                script {
                    // Run Docker container with volume mount and port mapping
                    echo "Starting container ${CONTAINER_NAME}..."
                    sh "docker run -d --name ${CONTAINER_NAME} -v ${VOLUME_NAME}:/app/uploads ${IMAGE_NAME}:${IMAGE_TAG}"
                }
            }
        }
        
        stage('Clean Up') {
            steps {
                script {
                    // Remove unused images
                    echo "Cleaning up unused Docker images..."
                    sh "docker image prune -f"
                }
            }
        }
    }
    
    post {
        success {
            echo "Deployment successful!"
        }
        failure {
            echo "Deployment failed!"
        }
        always {
            echo "Pipeline execution completed."
        }
    }
}